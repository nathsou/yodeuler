
module Key(w: u5, h: u5) -> (q: u9) {
  let min_max = w < h ? (min: w, max: h) : (min: h, max: w)
  q = min_max.min * 20 + min_max.max
}

module Solution(clk: clock, rst: bool) -> (is_ready: bool, q: u38) {
  let w = Reg[u5](clk, rst)
  let h = Reg[u5](clk, rst)
  let count: u38
  let prev_w: u5 = w.q - 1
  let prev_h: u5 = h.q - 1
  let addr1 = Key(w: w.q != 0 ? prev_w : 0, h: h.q).q
  let addr2 = Key(w: w.q, h: h.q != 0 ? prev_h : 0).q
    let memo = Memory[
      T: u38,
      Depth: 420,
      ReadPorts: 2,
      WritePorts: 1,
      ReadLatency: 0,
      WriteLatency: 1,
    ](
      read: [
        (clk: clk, en: true, addr: addr1),
        (clk: clk, en: true, addr: addr2),
      ],
      write: [
        (clk: clk, en: not is_ready, addr: Key(w: w.q, h: h.q).q, data: count, mask: true),
      ],
    )

    is_ready = w.q == 20 and h.q == 20

    if not is_ready {
      if w.q < 20 {
        w.d = w.q + 1
      } else {
        h.d = h.q + 1
        w.d = 1
      }
    }

    if w.q == 0 {
      count = 1
    } else if w.q == 1 {
      count = h.q + 1
    } else {
      count = memo.q[0] + memo.q[1]
    }

    q = count
}
