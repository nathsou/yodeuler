
module Solution(clk: clock, rst: bool) -> (is_ready: bool, q: u25) {
    let i = Reg[u7](clk, rst)
    let sum = Reg[u25](clk, rst)
    let sum_sq = Reg[u25](clk, rst)
    is_ready = i.q == 101
    q = sum.q * sum.q - sum_sq.q

    if not is_ready {
        sum.d = sum.q + i.q
        sum_sq.d = sum_sq.q + i.q * i.q
        i.d = i.q + 1
    }
}
