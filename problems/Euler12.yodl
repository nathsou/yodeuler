import Arithmetic

module Solution(clk: clock, rst: bool) -> (is_ready: bool, q: u27) {
  let tri = Reg[u27](clk, rst, q)
  let i = Reg[u14](clk, rst)
  let factors = Arithmetic::CountFactors(clk, n: tri.q)
  is_ready = factors.is_ready and factors.q > 500
  factors.rst = rst

  if not is_ready and factors.is_ready {
    tri.d = tri.q + i.q
    i.d = i.q + 1
    factors.rst = true
  }
}
