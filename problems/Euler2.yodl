
module Solution(clk: clock, rst: bool) -> (q: u23, is_ready: bool) {
  let sum = Reg[u23](clk, rst, q)
  let a = Reg[u23](clk, rst)
  let b = Reg[u22](clk, rst)
  is_ready = a.q > 4_000_000

  if a.q == 0 {
    a.d = 1
    b.d = 1
  } else if not is_ready {
    a.d = a.q + b.q
    b.d = a.q[21:0]

    if not a.q[0] {
      sum.d = sum.q + a.q
    }
  }
}
